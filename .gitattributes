# Auto detect text files and normalize line endings to LF across OS & CI
* text=auto eol=lf

# Executables & scripts must strictly retain LF line endings
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf

# Web source files & styling
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.xml text eol=lf
*.xsl text eol=lf

# Documentation & configuration
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Graphic, media & binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
